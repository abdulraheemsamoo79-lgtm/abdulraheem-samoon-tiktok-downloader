# ── AR SAMOON · TikTok Downloader — Environment Variables ──────────────────
#
# Copy this file to .env.local for local development, and add the same
# keys under Vercel → Project → Settings → Environment Variables for
# production.

# Provider used to resolve TikTok URLs. Currently supported: "tikwm"
TIKTOK_PROVIDER=tikwm

# TikWM does not require an API key for standard use. This is left here
# so a future/paid provider (or a TikWM key, if you obtain one) can be
# dropped in without touching any code — see lib/tiktok/tikwm.ts.
TIKTOK_API_KEY=

# Max time (ms) to wait for the provider before failing gracefully.
TIKTOK_REQUEST_TIMEOUT_MS=15000

# Simple in-memory rate limit: max requests per IP per window.
RATE_LIMIT_MAX=20
RATE_LIMIT_WINDOW_MS=60000
