# ── AR SAMOON · TikTok Downloader — Environment Variables ──────────────────
#
# Copy this file to .env.local for local development, and add the same
# keys under Vercel → Project → Settings → Environment Variables for
# production.

# Provider used to resolve TikTok URLs. Currently supported: "tikwm"
TIKTOK_PROVIDER=tikwm

# TikWM does not require an API key for standard use. This is left here
# so a future/paid provider (or a TikWM key, if you obtain one) can be
# dropped in without touching any code — see lib/tiktok/tikwm.ts.
TIKTOK_API_KEY=

# Max time (ms) to wait for the provider before failing gracefully.
TIKTOK_REQUEST_TIMEOUT_MS=15000

# Simple in-memory rate limit: max requests per IP per window.
RATE_LIMIT_MAX=20
RATE_LIMIT_WINDOW_MS=60000

# ── Instagram (and future YouTube/Snapchat) ─────────────────────────────
#
# Instagram has no free hosted resolver equivalent to TikWM, so this
# uses a self-hosted Cobalt instance (https://github.com/imputnet/cobalt).
# Deploy your own in a few minutes via Railway's official template
# (see README → "Setting up Instagram downloads"), then paste its URL here.

# Provider used to resolve Instagram URLs. Currently supported: "cobalt"
INSTAGRAM_PROVIDER=cobalt

# URL of YOUR self-hosted Cobalt instance, e.g. https://your-app.up.railway.app
# Leave empty and Instagram downloads will show a clear "not configured"
# error instead of pretending to work.
COBALT_API_URL=

# Only needed if you enabled AUTH_REQUIRED / API keys on your Cobalt instance.
COBALT_API_KEY=

# Max time (ms) to wait for the Cobalt instance before failing gracefully.
COBALT_REQUEST_TIMEOUT_MS=20000
